classDiagram
    class BrowserPhone {
        <<JavaScript POC>>
        +call(callerNumber, useDraft)
        +pressKey(digit)
        -voiceActivityDetection()
        -browserSpeechRecognition() English
        -encodeWav(samples) Blob
        -playReply(segments)
    }
    class CallController {
        +store(StartCallRequest)
        +utterance(StoreCallUtteranceRequest, CallSession)
        +input(StoreCallInputRequest, CallSession)
        +destroy(CallSession)
    }
    class ConversationEngine {
        <<runs the IVR flow>>
        +startCall(callerNumber, channel, direction, useDraft)
        +handleSpeech(CallSession, audio, mimeType) AssistantReply
        +handleInput(CallSession, CallInput) AssistantReply
        +hangUp(CallSession)
        -runFrom(call, step)
        -askAgain(call, step)
        -speakStep(call, step, slot)
    }
    class IntentResolver {
        +matchBranch(branches, transcript, Language) FlowStep
        +branchByKeypad(branches, digits) FlowStep
        +chosenLanguage(transcript) Language
        +chosenLanguageByKeypad(digits) Language
    }
    class NumberParser {
        +parse(transcript, Language) float
    }
    class PromptAudioResolver {
        +languageFor(step, slot, callLanguage, languages) Language
        +status(step, language, languages) array
    }
    class FlowPublisher {
        +live() CallFlow
        +draft() CallFlow
        +problems(draft) list
        +publish(draft) list
        +discardDraft() CallFlow
        +copy(flow) CallFlow
    }
    class FlowEditor {
        +addStep(flow, branch, position, kind) FlowStep
        +addBranch(choice) FlowStep
        +moveStep(step, branch, position)
        +moveBranch(branch, position)
        +delete(step)
    }
    class DefaultCallFlow {
        +create() CallFlow
    }
    class ClipRecordingStore {
        +store(clip, language, audio, filename) ClipRecording
        +remove(recording)
    }
    class Builder {
        <<Livewire IVR flow page>>
    }
    class DynamicSpeech {
        +segment(text) array
    }
    class AudioTranscoder {
        <<ffmpeg>>
        +prepareForRecognition(audio) PreparedAudio
        +forBrowserPlayback(audio) string
        +forTelephony(audio) string
    }
    class SpeechRecognizer {
        <<interface>>
        +transcribe(audio, mimeType, Language, CallSession) string
    }
    class KhayaSpeechRecognizer
    class FakeSpeechRecognizer
    class KhayaQuotaGuard {
        +ensureAvailable()
        +summary() array
    }
    class AbenaTextToSpeech {
        +synthesize(text, voice) string
    }
    class Language {
        <<model, soft deletes>>
        +code
        +speech_recognition khaya browser keypad
        +position
        +enabled
        +is_primary
    }
    class CallFlow {
        +version
        +status draft published archived
        +settings
    }
    class FlowStep {
        +type
        +parent_id
        +position
        +keypad_digit
        +config
        +is_otherwise
        +go_to_step_id
    }
    class AudioClip
    class ClipRecording
    BrowserPhone ..> CallController : HTTPS JSON and WAV
    CallController --> ConversationEngine
    ConversationEngine --> FlowPublisher : live or draft version
    ConversationEngine --> IntentResolver
    ConversationEngine --> NumberParser
    ConversationEngine --> PromptAudioResolver
    ConversationEngine --> SpeechRecognizer
    ConversationEngine --> AudioTranscoder
    ConversationEngine --> DynamicSpeech
    SpeechRecognizer <|.. KhayaSpeechRecognizer
    SpeechRecognizer <|.. FakeSpeechRecognizer
    KhayaSpeechRecognizer --> KhayaQuotaGuard
    DynamicSpeech --> AbenaTextToSpeech
    Builder --> FlowEditor
    Builder --> FlowPublisher
    Builder --> ClipRecordingStore
    Builder --> PromptAudioResolver
    FlowPublisher --> DefaultCallFlow
    DefaultCallFlow --> ClipRecordingStore
    ClipRecordingStore --> AudioTranscoder
    CallFlow "1" *-- "many" FlowStep
    CallFlow "1" *-- "many" AudioClip
    FlowStep "1" o-- "many" FlowStep : branches and nested steps
    AudioClip "1" *-- "many" ClipRecording
    ClipRecording --> Language
